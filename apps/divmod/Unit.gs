/**
 * Unit.gs — あまりのあるわり算（3年）
 *
 * 九九タイムアタックが測るのは「1回の想起の速さ」。
 * こちらが測るのは「あまりを出す手続きが1手で出るか、数え上げているか」。
 * 同じ児童を並べると「わり切れるわり算は速いのに、あまりが出ると遅い」が見える。
 *
 * 3つの型を、順番に開けていく。
 *   ① 九九さがし   その数をこえない、その段の いちばん大きい答え（商の見つけ方そのもの）
 *   ② はんだん     示された式が正しいか確かめて、正しい答えを書く（あまり≧わる数の誤り）
 *   ③ わり算       あまりのあるわり算
 */

var UNIT = {
  id: 'divmod',
  title: 'あまりのあるわり算 タイムアタック！',
  teacherTitle: 'あまりのあるわり算 設定・分析',

  defaults: {
    // 九九(3000)より長く取る。1回の想起ではなく、探索→検証→表現の手続きを測るため。
    // 暫定値。1〜2週ぶん log が貯まったら type_stats の分布で置き換えること。
    slow_ms: 6000
  },

  /** 「あまり」は答えの欄のあいだに出る。q の中にも同じトークンで出す */
  units: { 'あまり': '' },

  modes: [
    { id: 1, name: '九九さがし', desc: '6のだん 29まで',
      help: 'その だんの こたえで、その かずを こえない いちばん 大きい かず' },

    { id: 2, name: 'あってる？', desc: '32÷9＝2あまり14',
      needs: { mode: 1, tries: 3 },
      help: '上の しきを たしかめて、正しい こたえを 書こう' },

    { id: 3, name: 'あまりのある わり算', desc: '32÷9',
      needs: { mode: 2, tries: 3 } },

    // 同じ型を続けるほうがその場の成績は上がるが、保持は混合のほうが良い
    // （docs/ADD_UNIT.md 7章）。最後に混合を置く。
    { id: 4, name: 'ぜんぶ まぜ', desc: '①②③',
      needs: { mode: 3, tries: 3 } }
  ],

  /**
   * 分析の軸。段別（2〜9の段）に割らない。
   * 段の想起は九九タイムアタックが既に測っていて、ここで8列作ると二重計測になり、
   * weak_child が読めない幅になる。ここで見たいのは段ではなく手続きの段階。
   *
   * ②を「正しい式」と「誤りの式」に分けてあるのは、
   * 正しい式まで直してしまう過剰修正（あまりを見ずに解き直す子）を切り分けるため。
   */
  types: {
    P:  '①九九さがし',
    Jo: '②はんだん(正しい式)',
    Jx: '②はんだん(あまりが大)',
    R:  '③あまりのあるわり算'
  },

  /**
   * 全型で打鍵数を2打（①は2桁、②③は商1桁＋あまり1桁）に揃えてある。
   * 揃えないと、主指標である所要msに型ごとの打鍵数の差が乗る
   * （docs/ARCHITECTURE.md「自動判定と情報漏れ」）。
   * gen 側でも値域を揃えているので、宣言と実際の桁数が食い違わない。
   */
  digitCap: {
    P:  { '': 2 },
    Jo: { 'あまり': 1, '': 1 },
    Jx: { 'あまり': 1, '': 1 },
    R:  { 'あまり': 1, '': 1 }
  },

  /** 誤答を「3あまり5」の形で出す。欄キーがそのまま後ろに付く */
  fieldsByType: {
    P:  [''],
    Jo: ['あまり', ''],
    Jx: ['あまり', ''],
    R:  ['あまり', '']
  },

  tips:
    '<b>weak_child</b>：児童ごと・型ごとの平均想起時間(秒)。<code>slow_ms</code> を超えると赤。<br>' +
    '測っているのは想起の速さではなく、あまりを出す手続きが1手で出るかどうか。<br><br>' +
    '・①だけ赤 → 九九の想起が未定着。九九タイムアタックの段別を見る<br>' +
    '・①は緑で③が赤 → 九九は出るが、商とあまりへの分解ができていない<br>' +
    '・②が③より遅い → 示された答えを確かめられず、一から解き直している<br>' +
    '・Jo（正しい式）だけ誤答が多い → あまりを見ずに直す過剰修正。「たしかめ」の指導へ<br>' +
    '・Jx（あまりが大）だけ誤答が多い → あまり＜わる数 が条件として入っていない<br>' +
    '・ゆらぎが大きい → 想起と数え上げを行き来している。手続きの短縮より想起の練習',

  /**
   * 1問作る。
   *
   * 全型で わられる数は2桁（10〜89）、①の答えは2桁（10〜81）、
   * 商は1桁、あまりは 1〜(わる数-1) に揃えてある。
   *
   * あまり0（わり切れる）を出さないのは2つ理由がある。
   * 1つは指導との整合で、3年ではわり切れるとき「あまり0」とは書かない。
   * もう1つは画面の仕様で、ui.html は空欄を0として扱い、
   * 全欄が正解と一致した瞬間に自動送信する。あまり0の問題を出すと、
   * 商を打った時点（あまり欄は空＝0）で正解と一致してしまい、
   * あまりを書かせないまま次の問題へ進む。
   */
  gen: function (rand, mode) {
    var kind = (mode === 4) ? ri_(rand, 1, 3) : mode;
    if (kind === 1) return dmSearch_(rand);
    if (kind === 2) return dmJudge_(rand);
    return dmDivide_(rand);
  }
};

/**
 * ①「6のだん　29まで」＝ 29 をこえない 6の段の答えのうち いちばん大きいもの → 24。
 * 段を先に置くのは、商をさがす手続き（段を決める→上限を見る）と読み順を揃えるため。
 *
 * 基準数は必ず「その段の倍数ではない数」にする。倍数を出すと
 * 教科書の「29より小さい」と手続き上の「29以下」で答えが割れ、
 * 同じ問題文が2通りに読めてしまう。
 */
function dmSearch_(rand) {
  var a = ri_(rand, 2, 9);                               // だん
  var b = ri_(rand, Math.ceil(10 / a), 9);               // 積を2桁に揃える（10〜81）
  var r = ri_(rand, 1, a - 1);                           // 倍数にしないためのずらし
  var n = a * b + r;                                     // 基準数（11〜89）
  return {
    t: 'P',
    q: [String(a), 'のだん　', String(n), 'まで'],
    f: [''], ans: { '': a * b },
    tag: n + '<' + a
  };
}

/**
 * ②示された式を確かめて、正しい商とあまりを書く。
 *
 * ○×の2択にしていない。スコアは正答数だけで誤答に減点が無く、
 * miss_limit 回まちがえると正答が出る作りなので、2択は連打が最適戦略になり、
 * 順位と weak_child の想起時間が同時に壊れる。
 *
 * 誤りは「商が1小さく、あまりが わる数だけ大きい」の1種類だけ。
 * 商を1大きくするとあまりが負になるので、3年の範囲で作れる誤りはこの向きしかない。
 * 正しい式を3問に1問まぜ、「いつも直せばよい」戦略を潰す。
 */
function dmJudge_(rand) {
  var x = dmParts_(rand);
  var ok = (ri_(rand, 1, 3) === 1);
  var sb = ok ? x.b : x.b - 1;                           // 示された商
  var sr = ok ? x.r : x.r + x.a;                         // 示されたあまり
  return {
    t: ok ? 'Jo' : 'Jx',
    q: [String(x.n), '÷', String(x.a), '=', String(sb), 'あまり', String(sr)],
    f: ['あまり', ''], ans: { 'あまり': x.b, '': x.r },
    tag: x.n + '/' + x.a + '>' + sb + 'a' + sr
  };
}

/** ③あまりのあるわり算 */
function dmDivide_(rand) {
  var x = dmParts_(rand);
  return {
    t: 'R',
    q: [String(x.n), '÷', String(x.a)],
    f: ['あまり', ''], ans: { 'あまり': x.b, '': x.r },
    tag: x.n + '/' + x.a
  };
}

/**
 * ②③が共有する値域。わる数 2〜9、商 2〜9、あまり 1〜(わる数-1)、
 * わられる数は2桁（10〜89）。
 * 商が2以上なのは、②の誤り式（商を1小さくする）が作れるようにするため。
 */
function dmParts_(rand) {
  var a = ri_(rand, 2, 9);
  var r = ri_(rand, 1, a - 1);
  var b = ri_(rand, Math.max(2, Math.ceil((10 - r) / a)), 9);
  return { a: a, b: b, r: r, n: a * b + r };
}
